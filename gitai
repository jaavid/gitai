#!/usr/bin/env bash

# GitAI - AI-assisted Conventional Commits with a terminal-native workflow.

set -euo pipefail

VERSION="0.2.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
USER_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/gitai/config"
LEGACY_HOME_CONFIG="$HOME/.bin/gitai/.gitai"

fail() {
  printf 'gitai: %s\n' "$*" >&2
  exit 1
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

for dependency in git curl jq; do
  command_exists "$dependency" || fail "Missing dependency: $dependency"
done

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail "Run gitai inside a Git repository."
GIT_ROOT="$(git rev-parse --show-toplevel)"

# Configuration precedence (later files win):
# 1. install-local legacy config
# 2. historical ~/.bin/gitai/.gitai config
# 3. XDG user config
# 4. repository config
source_config() {
  local file="$1"
  [ -f "$file" ] || return 0
  # Config files intentionally contain shell-style export statements.
  # shellcheck disable=SC1090
  source "$file"
}

source_config "$SCRIPT_DIR/.gitai"
if [ "$LEGACY_HOME_CONFIG" != "$SCRIPT_DIR/.gitai" ]; then
  source_config "$LEGACY_HOME_CONFIG"
fi
source_config "$USER_CONFIG"
source_config "$GIT_ROOT/.gitai"

PROVIDER_CHAIN_RAW="${GITAI_PROVIDER:-avalapis}"
MAX_DIFF_LENGTH="${GITAI_MAX_DIFF_LENGTH:-12000}"
DEFAULT_API_KEY="${GITAI_API_KEY:-}"
TUI_ENABLED="${GITAI_TUI:-1}"
AUTO_PUSH_MODE=""
FORCE_SETUP=0

if ! [[ "$MAX_DIFF_LENGTH" =~ ^[0-9]+$ ]] || [ "$MAX_DIFF_LENGTH" -eq 0 ]; then
  fail "GITAI_MAX_DIFF_LENGTH must be a positive integer."
fi

is_interactive() {
  [ -t 0 ] && [ -t 1 ]
}

use_gum() {
  [ "$TUI_ENABLED" != "0" ] && is_interactive && command_exists gum && [ "${TERM:-}" != "dumb" ]
}

ui_header() {
  local text="$1"
  if use_gum; then
    gum style --bold --border rounded --padding "0 2" "$text"
  else
    printf '\n== %s ==\n' "$text"
  fi
}

ui_note() {
  local text="$1"
  if use_gum; then
    gum style --faint "$text"
  else
    printf '%s\n' "$text"
  fi
}

ui_success() {
  local text="$1"
  if use_gum; then
    gum style --bold "✓ $text"
  else
    printf '✓ %s\n' "$text"
  fi
}

ui_warn() {
  local text="$1"
  if use_gum; then
    gum style --bold "! $text"
  else
    printf '! %s\n' "$text"
  fi
}

ui_confirm() {
  local prompt="$1"
  if use_gum; then
    gum confirm "$prompt"
  else
    local answer
    read -r -p "$prompt [y/N] " answer
    [[ "$answer" =~ ^[Yy]$ ]]
  fi
}

ui_choose() {
  local prompt="$1"
  shift

  if use_gum; then
    gum choose --header "$prompt" "$@"
    return
  fi

  local options=("$@")
  local i choice
  printf '%s\n' "$prompt" >&2
  for ((i = 0; i < ${#options[@]}; i++)); do
    printf '  %d) %s\n' "$((i + 1))" "${options[$i]}" >&2
  done
  while true; do
    read -r -p "> " choice
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#options[@]}" ]; then
      printf '%s\n' "${options[$((choice - 1))]}"
      return
    fi
    printf 'Choose a number between 1 and %d.\n' "${#options[@]}" >&2
  done
}

ui_secret() {
  local prompt="$1"
  local value
  if use_gum; then
    gum input --password --prompt "$prompt: "
  else
    read -r -s -p "$prompt: " value
    printf '\n' >&2
    printf '%s' "$value"
  fi
}

ui_input() {
  local prompt="$1"
  local value
  if use_gum; then
    gum input --prompt "$prompt: "
  else
    read -r -p "$prompt: " value
    printf '%s' "$value"
  fi
}

trim_value() {
  local value="$1"
  printf '%s' "$value" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

resolve_provider_api_key() {
  local provider="$1"

  case "$provider" in
    avalapis) printf '%s' "${GITAI_AVALAPIS_API_KEY:-$DEFAULT_API_KEY}" ;;
    openrouter) printf '%s' "${GITAI_OPENROUTER_API_KEY:-$DEFAULT_API_KEY}" ;;
    cloudflare) printf '%s' "${GITAI_CLOUDFLARE_API_KEY:-$DEFAULT_API_KEY}" ;;
    google) printf '%s' "${GITAI_GOOGLE_API_KEY:-$DEFAULT_API_KEY}" ;;
    *) printf '' ;;
  esac
}

configured_provider_has_key() {
  local raw_provider provider
  local providers=()
  IFS=',' read -r -a providers <<< "$PROVIDER_CHAIN_RAW"
  for raw_provider in "${providers[@]}"; do
    provider="$(trim_value "$raw_provider")"
    [ -n "$provider" ] || continue
    if [ -n "$(resolve_provider_api_key "$provider")" ]; then
      return 0
    fi
  done
  return 1
}

write_user_config() {
  local provider="$1"
  local key="$2"
  local account_id="${3:-}"
  local key_var

  case "$provider" in
    avalapis) key_var="GITAI_AVALAPIS_API_KEY" ;;
    openrouter) key_var="GITAI_OPENROUTER_API_KEY" ;;
    cloudflare) key_var="GITAI_CLOUDFLARE_API_KEY" ;;
    google) key_var="GITAI_GOOGLE_API_KEY" ;;
    *) fail "Unsupported provider: $provider" ;;
  esac

  mkdir -p "$(dirname "$USER_CONFIG")"
  umask 077

  # Replace GitAI-owned provider/key lines while preserving unrelated settings.
  local tmp
  tmp="$(mktemp)"
  if [ -f "$USER_CONFIG" ]; then
    grep -Ev '^export GITAI_PROVIDER=|^export GITAI_(AVALAPIS|OPENROUTER|CLOUDFLARE|GOOGLE)_API_KEY=|^export GITAI_CLOUDFLARE_ACCOUNT_ID=' "$USER_CONFIG" > "$tmp" || true
  fi

  {
    cat "$tmp"
    printf 'export GITAI_PROVIDER=%q\n' "$provider"
    printf 'export %s=%q\n' "$key_var" "$key"
    if [ "$provider" = "cloudflare" ] && [ -n "$account_id" ]; then
      printf 'export GITAI_CLOUDFLARE_ACCOUNT_ID=%q\n' "$account_id"
    fi
  } > "$USER_CONFIG"
  rm -f "$tmp"
  chmod 600 "$USER_CONFIG"
}

setup_credentials() {
  is_interactive || fail "No API key found. Configure $USER_CONFIG or $LEGACY_HOME_CONFIG, or run gitai --setup in an interactive terminal."

  ui_header "GitAI setup"
  ui_note "No API key was found for the configured provider."
  ui_note "Credentials will be stored in $USER_CONFIG with mode 600."

  local selection provider key account_id=""
  selection="$(ui_choose "Choose your AI provider" \
    "Google AI Studio (Gemini)" \
    "OpenRouter" \
    "AvalAI / AvalAPIs" \
    "Cloudflare Workers AI")"

  case "$selection" in
    "Google AI Studio (Gemini)") provider="google" ;;
    "OpenRouter") provider="openrouter" ;;
    "AvalAI / AvalAPIs") provider="avalapis" ;;
    "Cloudflare Workers AI") provider="cloudflare" ;;
    *) fail "Setup canceled." ;;
  esac

  key="$(ui_secret "API key")"
  [ -n "$key" ] || fail "API key cannot be empty."

  if [ "$provider" = "cloudflare" ]; then
    account_id="$(ui_input "Cloudflare account ID")"
    [ -n "$account_id" ] || fail "Cloudflare account ID cannot be empty."
  fi

  write_user_config "$provider" "$key" "$account_id"

  export GITAI_PROVIDER="$provider"
  PROVIDER_CHAIN_RAW="$provider"
  case "$provider" in
    avalapis) export GITAI_AVALAPIS_API_KEY="$key" ;;
    openrouter) export GITAI_OPENROUTER_API_KEY="$key" ;;
    cloudflare)
      export GITAI_CLOUDFLARE_API_KEY="$key"
      export GITAI_CLOUDFLARE_ACCOUNT_ID="$account_id"
      ;;
    google) export GITAI_GOOGLE_API_KEY="$key" ;;
  esac
  DEFAULT_API_KEY="${GITAI_API_KEY:-}"
  ui_success "Configuration saved to $USER_CONFIG"
}

build_chat_prompt() {
  local diff_content="$1"

  cat <<PROMPT
You are a Git expert AI assistant. Given the following staged git diff, generate a structured commit message following Conventional Commits.

Output exactly these two lines:
Title: <type>(<scope>): <short summary>
Description: <clear explanation of what changed and why>

Rules:
- Allowed types: feat, fix, docs, chore, refactor, test, build, ci, style
- Scope is optional; use a concise feature/folder scope when clear
- Keep the title under 72 characters
- Do not use Markdown fences
- Keep the description concise but informative

Git diff:
$diff_content
PROMPT
}

set_provider_defaults() {
  local provider="$1"

  case "$provider" in
    avalapis)
      ATTEMPT_API_BASE="${GITAI_API_BASE:-https://api.avalapis.ir/v1/chat/completions}"
      ATTEMPT_MODEL="${GITAI_AVALAPIS_MODEL:-${GITAI_MODEL:-gpt-4.i-nano}}"
      ;;
    openrouter)
      ATTEMPT_API_BASE="${GITAI_API_BASE:-https://openrouter.ai/api/v1/chat/completions}"
      ATTEMPT_MODEL="${GITAI_OPENROUTER_MODEL:-${GITAI_MODEL:-openai/gpt-4o-mini}}"
      ;;
    cloudflare)
      ATTEMPT_API_BASE="${GITAI_API_BASE:-https://api.cloudflare.com/client/v4/accounts/${GITAI_CLOUDFLARE_ACCOUNT_ID:-}/ai/v1/chat/completions}"
      ATTEMPT_MODEL="${GITAI_CLOUDFLARE_MODEL:-${GITAI_MODEL:-@cf/meta/llama-3.3-70b-instruct-fp8-fast}}"
      ;;
    google)
      ATTEMPT_MODEL="${GITAI_GOOGLE_MODEL:-${GITAI_MODEL:-gemini-2.0-flash}}"
      ATTEMPT_API_BASE="${GITAI_API_BASE:-https://generativelanguage.googleapis.com/v1beta/models/${ATTEMPT_MODEL}:generateContent}"
      ;;
    *)
      LAST_ERROR="Unsupported provider '$provider'. Supported: avalapis, openrouter, cloudflare, google"
      return 1
      ;;
  esac
}

call_chat_completions_api() {
  local provider="$1"
  local prompt="$2"
  local api_key="$3"
  local response

  JSON_PAYLOAD=$(jq -n \
    --arg model "$ATTEMPT_MODEL" \
    --arg user "$prompt" \
    '{model: $model, messages: [{role: "user", content: $user}], temperature: 0.4}')

  local -a headers
  headers=(-H "Content-Type: application/json" -H "Authorization: Bearer $api_key")

  if [ "$provider" = "openrouter" ]; then
    headers+=(-H "HTTP-Referer: https://github.com/jaavid/gitai" -H "X-Title: GitAI")
  fi

  if ! response=$(curl -sfL "$ATTEMPT_API_BASE" "${headers[@]}" -d "$JSON_PAYLOAD" 2>&1); then
    LAST_ERROR="API request failed: $response"
    return 1
  fi

  COMMIT_MESSAGE=$(printf '%s' "$response" | jq -r '.choices[0].message.content // empty')
  if [ -z "$COMMIT_MESSAGE" ]; then
    LAST_ERROR="Empty/invalid response from provider '$provider'"
    return 1
  fi
}

call_google_api() {
  local prompt="$1"
  local api_key="$2"
  local response

  JSON_PAYLOAD=$(jq -n \
    --arg user "$prompt" \
    '{contents: [{role: "user", parts: [{text: $user}]}], generationConfig: {temperature: 0.4}}')

  if ! response=$(curl -sfL "$ATTEMPT_API_BASE?key=$api_key" \
    -H "Content-Type: application/json" \
    -d "$JSON_PAYLOAD" 2>&1); then
    LAST_ERROR="API request failed: $response"
    return 1
  fi

  COMMIT_MESSAGE=$(printf '%s' "$response" | jq -r '.candidates[0].content.parts[0].text // empty')
  if [ -z "$COMMIT_MESSAGE" ]; then
    LAST_ERROR="Empty/invalid response from provider 'google'"
    return 1
  fi
}

try_provider() {
  local provider="$1"
  local prompt="$2"
  local provider_key

  set_provider_defaults "$provider" || return 1
  provider_key="$(resolve_provider_api_key "$provider")"

  if [ -z "$provider_key" ]; then
    LAST_ERROR="Missing API key for provider '$provider'."
    return 1
  fi

  if [ "$provider" = "cloudflare" ] && [ -z "${GITAI_CLOUDFLARE_ACCOUNT_ID:-}" ] && [ -z "${GITAI_API_BASE:-}" ]; then
    LAST_ERROR="Missing GITAI_CLOUDFLARE_ACCOUNT_ID for provider 'cloudflare'."
    return 1
  fi

  if [ "$provider" = "google" ]; then
    call_google_api "$prompt" "$provider_key"
  else
    call_chat_completions_api "$provider" "$prompt" "$provider_key"
  fi
}

show_help() {
  cat <<'HELP'
GitAI — AI-assisted Conventional Commits

Usage:
  gitai [options]

Options:
  --setup          Configure an AI provider and API key
  --push           Push after committing (asks for remote if needed)
  --push-all       Push the new commit to every configured remote
  --no-push        Never ask to push
  --no-tui         Disable Gum UI and use plain terminal prompts
  -v, --version    Show version
  -h, --help       Show this help

Configuration (later files override earlier files):
  ~/.bin/gitai/.gitai       Legacy config used by older installations
  ~/.config/gitai/config    User-wide config (or $XDG_CONFIG_HOME/gitai/config)
  <repo>/.gitai             Repository-specific config

Environment:
  GITAI_PROVIDER           Provider or fallback chain
  GITAI_TUI=0              Disable terminal UI
  GITAI_MAX_DIFF_LENGTH    Maximum staged diff characters sent to AI
HELP
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --setup) FORCE_SETUP=1 ;;
    --push) AUTO_PUSH_MODE="ask-remote" ;;
    --push-all) AUTO_PUSH_MODE="all" ;;
    --no-push) AUTO_PUSH_MODE="none" ;;
    --no-tui) TUI_ENABLED=0 ;;
    -v|--version) printf 'gitai %s\n' "$VERSION"; exit 0 ;;
    -h|--help) show_help; exit 0 ;;
    *) fail "Unknown option: $1 (try --help)" ;;
  esac
  shift
done

if [ "$FORCE_SETUP" -eq 1 ]; then
  setup_credentials
  exit 0
fi

if ! configured_provider_has_key; then
  setup_credentials
fi

ui_header "GitAI · $(basename "$GIT_ROOT")"
CURRENT_BRANCH="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
if [ -n "$CURRENT_BRANCH" ]; then
  ui_note "Branch: $CURRENT_BRANCH"
else
  ui_warn "Detached HEAD: committing is allowed, pushing is disabled."
fi

git status --short

if [ -n "$(git status --porcelain)" ]; then
  STAGED_COUNT="$(git diff --cached --name-only | wc -l | tr -d ' ')"
  UNSTAGED_COUNT="$(git diff --name-only | wc -l | tr -d ' ')"
  UNTRACKED_COUNT="$(git ls-files --others --exclude-standard | wc -l | tr -d ' ')"
  ui_note "Staged: $STAGED_COUNT · Unstaged: $UNSTAGED_COUNT · Untracked: $UNTRACKED_COUNT"
fi

if [ -n "$(git status --porcelain)" ] && [ -z "$(git diff --cached --name-only)" ]; then
  STAGE_ACTION=$(ui_choose "No staged changes. What should GitAI do?" \
    "Stage all changes" \
    "Cancel")
  case "$STAGE_ACTION" in
    "Stage all changes") git add -A; ui_success "All changes staged" ;;
    *) exit 0 ;;
  esac
elif [ -n "$(git diff --name-only)$(git ls-files --others --exclude-standard)" ]; then
  STAGE_ACTION=$(ui_choose "There are changes outside the current index." \
    "Keep current staged changes" \
    "Stage all changes" \
    "Cancel")
  case "$STAGE_ACTION" in
    "Stage all changes") git add -A; ui_success "All changes staged" ;;
    "Cancel") exit 0 ;;
  esac
fi

GIT_DIFF="$(git diff --cached --no-ext-diff)"
[ -n "$GIT_DIFF" ] || fail "No staged changes found."

DIFF_LENGTH=${#GIT_DIFF}
TRIMMED_DIFF="$GIT_DIFF"
if [ "$DIFF_LENGTH" -gt "$MAX_DIFF_LENGTH" ]; then
  ui_warn "Diff is $DIFF_LENGTH characters; sending the first $MAX_DIFF_LENGTH characters."
  TRIMMED_DIFF="${GIT_DIFF:0:$MAX_DIFF_LENGTH}"
fi

PROMPT="$(build_chat_prompt "$TRIMMED_DIFF")"
IFS=',' read -r -a PROVIDER_CHAIN <<< "$PROVIDER_CHAIN_RAW"
COMMIT_MESSAGE=""
LAST_ERROR=""
SUCCESS_PROVIDER=""

for raw_provider in "${PROVIDER_CHAIN[@]}"; do
  provider="$(trim_value "$raw_provider")"
  [ -n "$provider" ] || continue

  ui_note "Trying provider: $provider"
  if try_provider "$provider" "$PROMPT"; then
    SUCCESS_PROVIDER="$provider"
    break
  fi
  ui_warn "Provider '$provider' failed: $LAST_ERROR"
done

[ -n "$SUCCESS_PROVIDER" ] || fail "All configured providers failed. Last error: $LAST_ERROR"
ui_success "Generated with $SUCCESS_PROVIDER"

TITLE="$(printf '%s\n' "$COMMIT_MESSAGE" | sed -n 's/^[Tt]itle:[[:space:]]*//p' | head -n 1)"
DESCRIPTION="$(printf '%s\n' "$COMMIT_MESSAGE" | sed -n 's/^[Dd]escription:[[:space:]]*//p' | head -n 1)"

[ -n "$TITLE" ] || fail "Provider response did not contain a Title line."
[ -n "$DESCRIPTION" ] || DESCRIPTION="AI-generated commit from staged changes."

ui_header "Suggested commit"
printf '%s\n\n%s\n' "$TITLE" "$DESCRIPTION"

if ! ui_confirm "Create this commit?"; then
  ui_note "Commit canceled."
  exit 0
fi

git commit -m "$TITLE" -m "$DESCRIPTION"
ui_success "Commit created"

if [ -z "$CURRENT_BRANCH" ]; then
  exit 0
fi

REMOTE_NAMES=()
while IFS= read -r remote; do
  [ -n "$remote" ] && REMOTE_NAMES+=("$remote")
done < <(git remote)

if [ "${#REMOTE_NAMES[@]}" -eq 0 ]; then
  ui_note "No Git remotes configured; push skipped."
  exit 0
fi

push_remote() {
  local remote="$1"
  ui_note "Pushing $CURRENT_BRANCH → $remote"
  git push "$remote" "$CURRENT_BRANCH"
  ui_success "Pushed to $remote"
}

push_all_remotes() {
  local remote
  for remote in "${REMOTE_NAMES[@]}"; do
    push_remote "$remote"
  done
}

case "$AUTO_PUSH_MODE" in
  none) exit 0 ;;
  all) push_all_remotes; exit 0 ;;
esac

if [ "${#REMOTE_NAMES[@]}" -eq 1 ]; then
  if [ "$AUTO_PUSH_MODE" = "ask-remote" ] || ui_confirm "Push to ${REMOTE_NAMES[0]}?"; then
    push_remote "${REMOTE_NAMES[0]}"
  fi
  exit 0
fi

PUSH_OPTIONS=("Skip push" "All remotes")
for remote in "${REMOTE_NAMES[@]}"; do
  url="$(git remote get-url --push "$remote" 2>/dev/null || git remote get-url "$remote" 2>/dev/null || true)"
  if [ -n "$url" ]; then
    PUSH_OPTIONS+=("$remote  ·  $url")
  else
    PUSH_OPTIONS+=("$remote")
  fi
done

PUSH_SELECTION="$(ui_choose "Where should this commit be pushed?" "${PUSH_OPTIONS[@]}")"
case "$PUSH_SELECTION" in
  "Skip push") exit 0 ;;
  "All remotes") push_all_remotes ;;
  *)
    SELECTED_REMOTE="${PUSH_SELECTION%%  ·  *}"
    push_remote "$SELECTED_REMOTE"
    ;;
esac
